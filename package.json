{
  "name": "form-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "浏览器表单自动填写引擎（求职申请场景）：LLM 在循环外，循环内全是确定性 JS",
  "license": "MIT",
  "keywords": [
    "autofill",
    "form",
    "job-application",
    "recruitment"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:privacy": "node scripts/check-private-leak.mjs",
    "check:privacy:staged": "node scripts/check-private-leak.mjs --staged",
    "check:privacy:history": "node scripts/check-private-leak.mjs --history",
    "check:ci": "npm test && node scripts/check-private-leak.mjs --patterns",
    "check": "npm test && npm run check:privacy"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "pdf-parse": "^2.4.5"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}
